  "description": "",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:coverage": "c8 --include='src/**/*.ts' --reporter=text --reporter=html node --import tsx --test test/app.test.ts",
